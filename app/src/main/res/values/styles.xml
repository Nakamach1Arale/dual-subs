<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">双语实时字幕</string>
    <string name="source_playback">机内音源\n<small>手机正在播放的声音（推荐）</small></string>
    <string name="source_mic">外部音源\n<small>麦克风收音，机内音源抓不到声音时用</small></string>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small caption above an input, so it stays visible after something is typed. -->
    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:alpha">0.75</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
